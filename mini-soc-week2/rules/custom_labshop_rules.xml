<group name="labshop,suricata,local,">
  <!-- Task 1: LabShop Rules -->
  <rule id="100100" level="0">
    <decoded_as>labshop</decoded_as>
    <user>monitor</user>
    <description>LabShop: Monitor health check (ignored)</description>
  </rule>

  <rule id="100101" level="5">
    <decoded_as>labshop</decoded_as>
    <action>LOGIN_FAILED</action>
    <description>LabShop: Failed login for user $(dstuser)</description>
  </rule>

  <rule id="100102" level="10" frequency="5" timeframe="60">
    <if_matched_sid>100101</if_matched_sid>
    <same_source_ip />
    <mitre>
      <id>T1110</id>
    </mitre>
    <description>LabShop: Brute force attack detected from IP $(srcip)</description>
  </rule>

  <rule id="100103" level="3">
    <decoded_as>labshop</decoded_as>
    <action>LOGIN_OK</action>
    <description>LabShop: Successful login for user $(dstuser)</description>
  </rule>

  <!-- Task 3: Suricata Rule -->
  <rule id="100110" level="10">
    <if_sid>86600</if_sid>
    <field name="event_type">http</field>
    <match>/admin</match>
    <description>Suricata: High Severity Admin Page Access Attempt</description>
  </rule>
</group>
